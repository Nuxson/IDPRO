# ============================================================================
# Docker-образ: Wine + Windows-Python + PyInstaller => IDPRO.exe на Linux-хосте
# ============================================================================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    WINEDEBUG=-all \
    WINEPREFIX=/root/.wine \
    WINEDLLOVERRIDES="mscoree,mshtml=" \
    XDG_RUNTIME_DIR=/tmp \
    PYVER=3.12.7

# --- Wine 9.x + утилиты -------------------------------------------------------
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl wget unzip xz-utils && \
    mkdir -pm755 /etc/apt/keyrings && \
    wget -O /etc/apt/keyrings/winehq-archive.key https://dl.winehq.org/wine-builds/winehq.key && \
    wget -O /etc/apt/sources.list.d/winehq-jammy.sources https://dl.winehq.org/wine-builds/ubuntu/dists/jammy/winehq-jammy.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends winehq-stable && \
    rm -rf /var/lib/apt/lists/*

# --- Инициализация Wine-префикса ----------------------------------------------
RUN wineboot --init >/dev/null 2>&1; wineserver -w

# --- Windows-CPython: embeddable-дистрибутив + pip + официальные OpenSSL DLLs -
ENV GETPIP_URL=https://bootstrap.pypa.io/get-pip.py \
    GETPIP_URL_EOL=https://bootstrap.pypa.io/pip/3.9/get-pip.py

RUN set -eux; \
    # 1. Скачиваем и распаковываем embeddable версию Python 3.12
    curl -fsSL -o /tmp/py-embed.zip \
      "https://www.python.org/ftp/python/${PYVER}/python-${PYVER}-embed-amd64.zip"; \
    mkdir -p /root/.wine/drive_c/Python312; \
    unzip -q /tmp/py-embed.zip -d /root/.wine/drive_c/Python312; \
    rm /tmp/py-embed.zip; \
    pth="$(ls /root/.wine/drive_c/Python312/python*._pth)"; \
    sed -i -e 's/^#\?import site/import site/' \
           -e '$a Lib\\site-packages' "$pth"; \
    \
    # 2. Устанавливаем pip
    curl -fsSL -o /tmp/get-pip.py "$GETPIP_URL" \
      || curl -fsSL -o /tmp/get-pip.py "$GETPIP_URL_EOL"; \
    wine 'C:\Python312\python.exe' /tmp/get-pip.py --no-cache-dir -q \
      || { echo "ERROR: get-pip failed"; wineserver -w; exit 1; }; \
    rm /tmp/get-pip.py; \
    \
    # 3. Скачиваем ПОЛНЫЙ архив Python (не embed), чтобы забрать оттуда официальные DLL OpenSSL
    curl -fsSL -o /tmp/py-full.zip \
      "https://www.python.org/ftp/python/${PYVER}/python-${PYVER}-amd64.zip"; \
    mkdir -p /tmp/py_full_extract; \
    unzip -q /tmp/py-full.zip -d /tmp/py_full_extract; \
    \
    # Копируем официальные DLL OpenSSL из полной версии в нашу embeddable-сборку
    cp -f /tmp/py_full_extract/DLLs/libssl-3.dll /root/.wine/drive_c/Python312/libssl-3.dll; \
    cp -f /tmp/py_full_extract/DLLs/libcrypto-3.dll /root/.wine/drive_c/Python312/libcrypto-3.dll; \
    \
    # 4. Очистка и финальная проверка
    rm -rf /tmp/py-full.zip /tmp/py_full_extract; \
    wineserver -w; \
    wine 'C:\Python312\python.exe' -c "import ssl, sys; print('windows-python OK:', sys.version, '| TLS:', ssl.OPENSSL_VERSION)"; \
    wine 'C:\Python312\python.exe' -m pip --version; \
    wineserver -w

ENV PYDIR='C:\Python312' \
    PYWINE='/root/.wine/drive_c/Python312/python.exe'

# --- Зависимости сборки (кэшируются отдельно от исходников) -------------------
RUN wine "$PYWINE" -m pip install --no-cache-dir --upgrade pip setuptools \
    && wine "$PYWINE" -m pip install --no-cache-dir \
        "pyinstaller==6.11.0" "fastapi>=0.116" "uvicorn[standard]>=0.30" "pydantic>=2.7" \
    && wineserver -w

# --- Копируем проект и собираем EXE --------------------------------------------
WORKDIR /work
COPY . /work
RUN rm -rf /work/dist-windows /work/build \
    && wine "$PYWINE" -m PyInstaller build.spec --distpath /work/dist-windows --workpath /tmp/build -y \
    && wineserver -w \
    && printf '@echo off\r\nset IDPRO_PORTABLE=1\r\ncd /d "%%~dp0"\r\nstart "" "IDPRO.exe" %%*\r\n' \
         > /work/dist-windows/IDPRO/run-portable.bat

CMD ["true"]
